# REQUIRED
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — login credentials for the web UI (defaults to empty / no login)
# APP_USERNAME=
# APP_PASSWORD=

# OPTIONAL — comma-separated client IPs allowed to hit the API
# When set, only listed IPs (plus 127.0.0.1 and ::1) can reach API routes
# ALLOWED_IPS=

# OPTIONAL — defaults shown
# AYEN_ODE_DB_PATH=data/ayen_ode.db
# AYEN_ODE_HOST=0.0.0.0
# AYEN_ODE_PORT=8000
# AYEN_ODE_RELOAD=1
